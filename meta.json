{
    "name": "EasyPanel",
    "slug": "easypanel",
    "logo": "logo.svg",
    "darkLogo": "logo-dark.svg",
    "description": "Deploy and operate applications on EasyPanel instances through the API.",
    "features": [
        "Application Deployment",
        "Container Image Source",
        "Git Deployment",
        "GitHub Integration",
        "Dockerfile Source",
        "Environment Variables",
        "Domain Management",
        "SSL Certificates",
        "Safe Cleanup"
    ],
    "config": {
        "provider": "easypanel",
        "url": "https://panel.example.com",
        "auth_token": "${EASYPANEL_AUTH_TOKEN}",
        "managed_prefix": "shipper-",
        "service_name": "app",
        "source": {
            "type": "image",
            "image": "ghcr.io/acme/backend:latest"
        }
    },
    "install": "composer require shippercli/provider-easypanel"
}
