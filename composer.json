{
  "name": "shippercli/provider-easypanel",
  "description": "Official EasyPanel deployment provider for Shipper CLI.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "ShipperCli\\ProviderEasyPanel\\": "src/",
      "ShipperCli\\Contracts\\": "src/Contracts/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "shipper": {
      "plugin": "ShipperCli\\ProviderEasyPanel\\EasyPanelPlugin"
    }
  }
}
